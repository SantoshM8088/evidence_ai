# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=
# Any OpenAI chat model that supports Structured Outputs (JSON schema) via the Responses API.
OPENAI_CHAT_MODEL=gpt-6.1-sol
# Used for BOTH documents and queries. Changing it later re-embeds current documents automatically.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
